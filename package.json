{
  "name": "tweak",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "admin"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace=admin",
    "dev:mobile": "cd mobile && npm run start",
    "dev:backend": "cd backend && venv/bin/uvicorn app.main:app --reload --port 8000",
    "seed": "cd backend && venv/bin/python -m app.seeds.seed",
    "lint:admin": "npm run lint --workspace=admin",
    "lint:mobile": "cd mobile && npm run lint"
  }
}
