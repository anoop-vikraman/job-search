# Postgres (compose service name is `postgres`; host access via localhost)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tweak_db

# Backend reads the DB at localhost from the host, postgres:5432 from inside compose.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tweak_db

# JWT — set a strong secret (>= 32 chars) in the real .env
SECRET_KEY=change_me_to_a_long_random_secret_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS origins (comma-separated) for the admin panel / mobile dev
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Expo push: sent to registered devices after each notification commits.
EXPO_PUSH_ENABLED=true
# Only needed if "enhanced push security" is enabled on the EAS project.
# EXPO_ACCESS_TOKEN=

# Razorpay (sandbox: rzp_test_ keys from Dashboard → Test mode → API Keys).
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# Secret you set on the webhook in the dashboard (not the API secret).
# RAZORPAY_WEBHOOK_SECRET=
# Legacy no-payment top-up endpoint; set false anywhere real money is involved.
WALLET_SIMULATED_TOPUP_ENABLED=true

# OTP SMS: console (dev; logs + echoes the code), msg91 or twilio.
SMS_PROVIDER=console
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Background worker runs inside the API for local dev; use `python -m app.worker` in production.
RUN_WORKER_IN_APP=true

# Error tracking (optional)
# SENTRY_DSN=
SENTRY_ENVIRONMENT=development
