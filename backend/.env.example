# Postgres (compose service name is `postgres`; host access via localhost)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tweak_db

# Backend reads the DB at localhost from the host, postgres:5432 from inside compose.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tweak_db

# JWT — set a strong secret (>= 32 chars) in the real .env
SECRET_KEY=change_me_to_a_long_random_secret_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS origins (comma-separated) for the admin panel / mobile dev
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Expo push: sent to registered devices after each notification commits.
EXPO_PUSH_ENABLED=true
# Only needed if "enhanced push security" is enabled on the EAS project.
# EXPO_ACCESS_TOKEN=
